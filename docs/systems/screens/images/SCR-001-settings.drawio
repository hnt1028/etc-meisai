        </mxCell>
        <mxCell id="deleteTitle" value="取り込んだデータの削除" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="56" y="312" width="288" height="24" as="geometry" />
        </mxCell>
        <mxCell id="deleteBtn" value="すべて削除する" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=none;strokeColor=#6c8ebf;fontColor=#6c8ebf;" vertex="1" parent="1">
