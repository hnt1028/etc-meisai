        <mxCell id="importBtn" value="CSVを選んで取り込む" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#6c8ebf;fontColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="56" y="144" width="288" height="40" as="geometry" />
        </mxCell>
        <mxCell id="importResult" value="追加 12 件 / 上書き 3 件 / 無視 100 件（取り込み後に表示）" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;align=left;spacingLeft=6;fontSize=11;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="56" y="196" width="288" height="30" as="geometry" />
        </mxCell>
        <mxCell id="importError" value="取り込めませんでした: …（失敗したときに表示）" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;align=left;spacingLeft=6;fontSize=11;fontColor=#b85450;strokeColor=#b85450;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="56" y="236" width="288" height="30" as="geometry" />
        </mxCell>
        <mxCell id="divider" value="" style="endArrow=none;html=1;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="40" y="296" as="sourcePoint" />
            <mxPoint x="360" y="296" as="targetPoint" />
